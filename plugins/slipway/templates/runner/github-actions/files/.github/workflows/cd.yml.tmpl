# Generated by slipway (runner=github-actions, compute=<% options.compute %>). Regenerate with the scaffold; do not hand-edit.
# CD: deploy ONE immutable image tag to ONE environment. `plan` runs first and publishes the plan for review;
# `apply` runs only after the GitHub environment approval and applies exactly that plan.
name: cd

on:
  workflow_dispatch:
    inputs:
      tag:
        description: Immutable image tag from CI (semver, e.g. 0.1.13)
        required: true
        type: string
      environment:
        description: Target environment
        required: true
        default: <% github.cd_environment %>
        type: choice
        options:
<%#each environments%>          - <% this %>
<%/each%>
concurrency:
  group: cd-${{ inputs.environment }}
  cancel-in-progress: false

permissions:
  id-token: write
  contents: read

env:
  TF_IN_AUTOMATION: "true"
  TF_INPUT: "false"
  ARM_USE_OIDC: "true"
  ARM_USE_AZUREAD: "true"
  ARM_CLIENT_ID: ${{ secrets.AZURE_CLIENT_ID }}
  ARM_TENANT_ID: ${{ secrets.AZURE_TENANT_ID }}
  ARM_SUBSCRIPTION_ID: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
  IMAGE_TAG: ${{ inputs.tag }}

jobs:
  plan:
    name: plan ${{ inputs.tag }} → ${{ inputs.environment }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - name: Validate the tag
        run: |
          case "$IMAGE_TAG" in
            latest|main|master|dev|develop|staging|prod|production) echo "::error::'$IMAGE_TAG' is a mutable tag; deploy a semver tag from CI"; exit 1;;
          esac
          echo "$IMAGE_TAG" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+' || { echo "::error::'$IMAGE_TAG' is not a semver tag"; exit 1; }
      - name: Azure login (OIDC)
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
<%#eq options.registry "acr"%>      - name: Every app image must exist for this tag
        run: |
<%#each derived.apps%>          d=$(az acr repository show -n <% azure.acr_name %> --image "<% image_repository %>:$IMAGE_TAG" --query digest -o tsv 2>/dev/null || true)
          [ -n "$d" ] || { echo "::error::<% image_repository %>:$IMAGE_TAG not found in <% azure.acr_name %>"; exit 1; }
          echo "  <% name %>: $d"
<%/each%><%/eq%>      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_wrapper: false
      - name: terraform init / validate / plan
        working-directory: infra/app
        run: |
          terraform init -input=false
          terraform validate -no-color
          terraform plan -input=false -no-color -var "image_tag=$IMAGE_TAG" -out=tfplan | tee plan.txt
          {
            echo "## Plan for ${{ inputs.tag }} → ${{ inputs.environment }}"
            echo '```'; grep -E '^(Plan:|No changes)' plan.txt || tail -5 plan.txt; echo '```'
            echo '<details><summary>Full plan</summary>'; echo; echo '```'; cat plan.txt; echo '```'; echo '</details>'
          } >> "$GITHUB_STEP_SUMMARY"
      - uses: actions/upload-artifact@v7
        with:
          name: tfplan-${{ inputs.environment }}-${{ inputs.tag }}-${{ github.run_id }}
          path: |
            infra/app/tfplan
            infra/app/plan.txt
          retention-days: 1

  apply:
    name: apply ${{ inputs.tag }} → ${{ inputs.environment }}
    needs: plan
    runs-on: ubuntu-latest
    environment:
      name: ${{ inputs.environment }}   # required reviewer approves here, after reading the plan summary
      url: ${{ steps.outputs.outputs.url }}
    steps:
      - uses: actions/checkout@v7
      - name: Azure login (OIDC)
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_wrapper: false
      - uses: actions/download-artifact@v7
        with:
          name: tfplan-${{ inputs.environment }}-${{ inputs.tag }}-${{ github.run_id }}
          path: infra/app
      - name: terraform apply (the reviewed plan, nothing else)
        working-directory: infra/app
        run: |
          terraform init -input=false
          terraform apply -input=false -no-color tfplan | tee apply.txt
          echo "## Applied ${{ inputs.tag }} → ${{ inputs.environment }}" >> "$GITHUB_STEP_SUMMARY"
          grep -E '^Apply complete' apply.txt >> "$GITHUB_STEP_SUMMARY" || true
      - name: Collect outputs
        id: outputs
        working-directory: infra/app
        run: |
          terraform output -json > outputs.json
          python3 - <<'PY'
          import json
          o={k:v["value"] for k,v in json.load(open("outputs.json")).items()}
          urls=[v for k,v in o.items() if k.endswith("_url") and not k.endswith("_health_url")]
          print("\n".join(f"{k}={v}" for k,v in o.items()))
          with open("$GITHUB_OUTPUT","a") as f: f.write(f"url={urls[0] if urls else ''}\n")
          PY
      - name: Smoke test
        working-directory: infra/app
        run: |
          set -e; fail=0
          python3 - <<'PY' > smoke.txt || fail=1
          import json,urllib.request,ssl,time,sys
          o={k:v["value"] for k,v in json.load(open("outputs.json")).items()}; tag=o["image_tag"]; ok=True
          for k,url in o.items():
              if not k.endswith("_health_url"): continue
              app=k[:-len("_health_url")]
              for attempt in range(12):
                  try:
                      with urllib.request.urlopen(url, timeout=20) as r:
                          body=r.read().decode("utf-8","replace"); code=r.status; break
                  except Exception as e:
                      code=None; body=str(e); time.sleep(10)
              if code!=200: print(f"REFUTED  {app}: {url} -> {code} {body[:120]}"); ok=False; continue
              if body.lstrip().startswith("{"):
                  v=json.loads(body).get("version"); same=(v==tag)
                  print(f"{'CONFIRMED' if same else 'REFUTED '} {app}: {url} -> 200 version={v} (tag {tag})"); ok&=same
              else: print(f"CONFIRMED {app}: {url} -> 200")
          sys.exit(0 if ok else 1)
          PY
          cat smoke.txt; { echo "### Smoke test"; echo '```'; cat smoke.txt; echo '```'; } >> "$GITHUB_STEP_SUMMARY"
          exit $fail
      - uses: actions/upload-artifact@v7
        if: always()
        with:
          name: deploy-evidence-${{ inputs.environment }}-${{ inputs.tag }}
          path: |
            infra/app/outputs.json
            infra/app/apply.txt
            infra/app/smoke.txt
          retention-days: 90
