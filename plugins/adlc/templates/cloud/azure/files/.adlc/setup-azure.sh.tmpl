#!/usr/bin/env bash
# One-time Azure/Entra prerequisites for <% project.name %> — HUMAN-ONLY, idempotent.
# Generated by /adlc:bootstrap from .adlc/config.yaml (re-scaffold with --force to refresh).
#
#   bash .adlc/setup-azure.sh            # preflight + dry run: prints what would change, changes nothing
#   bash .adlc/setup-azure.sh --apply    # create/assign what is missing
#   bash .adlc/setup-azure.sh --apply --set-github-secrets   # also push AZURE_* secrets with gh
#
# What it creates: Entra app registration + service principal with two federated credentials (OIDC, no client
# secret), the Terraform state storage (Entra-only auth), the environment resource group, and least-privilege
# role assignments for the CI/CD principal and for you. It does NOT create ACR, Key Vault or the identity used by
# the apps: those belong to infra/foundation (Terraform). It never prints or stores a secret.
set -euo pipefail

APPLY=false; SET_SECRETS=false
for a in "$@"; do case "$a" in --apply) APPLY=true;; --set-github-secrets) SET_SECRETS=true;; -h|--help) sed -n '2,14p' "$0"; exit 0;; *) echo "unknown arg: $a" >&2; exit 2;; esac; done

# ---- names from .adlc/config.yaml ----
PROJECT="<% project.name %>"
LOCATION="<% azure.location %>"
RG="<% azure.resource_group %>"
STATE_RG="<% azure.state.resource_group %>"
STATE_SA="<% azure.state.storage_account %>"
STATE_CONTAINER="<% azure.state.container %>"
<%#eq options.runner "github-actions"%>GH_OWNER="<% github.owner %>"; GH_REPO="<% github.repo %>"; GH_BRANCH="<% github.default_branch %>"; GH_ENV="<% github.cd_environment %>"
<%/eq%>APP_NAME="sp-${PROJECT}-github"
ISSUER="https://token.actions.githubusercontent.com"
AUDIENCE="api://AzureADTokenExchange"

say()  { printf '\n\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '  ok    %s\n' "$*"; }
todo() { printf '  %s %s\n' "$($APPLY && echo 'apply' || echo 'would ')" "$*"; }
run()  { if $APPLY; then "$@"; else printf '        $ %s\n' "$*"; fi; }

# ---- preflight ----
say "Preflight"
command -v az >/dev/null || { echo "az CLI not installed" >&2; exit 1; }
SUB_ID=$(az account show --query id -o tsv 2>/dev/null) || { echo "not logged in: az login && az account set --subscription <id>" >&2; exit 1; }
TENANT_ID=$(az account show --query tenantId -o tsv); SUB_NAME=$(az account show --query name -o tsv)
ok "subscription: $SUB_NAME ($SUB_ID)"
<%#if azure.subscription_id%>[ "$SUB_ID" = "<% azure.subscription_id %>" ] || { echo "active subscription differs from .adlc/config.yaml (<% azure.subscription_id %>)" >&2; exit 1; }
<%/if%>ME_ID=$(az ad signed-in-user show --query id -o tsv); ME_UPN=$(az ad signed-in-user show --query userPrincipalName -o tsv); ok "user: $ME_UPN"
CAN_CREATE_APPS=$(az rest --method GET --url "https://graph.microsoft.com/v1.0/policies/authorizationPolicy" --query defaultUserRolePermissions.allowedToCreateApps -o tsv 2>/dev/null || echo unknown)
DIR_ROLES=$(az rest --method GET --url "https://graph.microsoft.com/v1.0/me/memberOf/microsoft.graph.directoryRole" --query "value[].displayName" -o tsv 2>/dev/null | tr '\n' ',' || true)
if [ "$CAN_CREATE_APPS" = "true" ] || echo "$DIR_ROLES" | grep -Eq 'Application Administrator|Cloud Application Administrator|Global Administrator'; then ok "can register applications (allowedToCreateApps=$CAN_CREATE_APPS; roles: ${DIR_ROLES:-none})"
else echo "  FAIL  cannot register applications: tenant policy allowedToCreateApps=$CAN_CREATE_APPS and no Application Administrator role. Ask a Cloud Application Administrator to run steps 1-2 or grant the role." >&2; PRE_FAIL=1; fi
SUB_ROLES=$(az role assignment list --assignee "$ME_ID" --all --include-inherited --query "[?scope=='/subscriptions/$SUB_ID' || scope=='/'].roleDefinitionName" -o tsv | sort -u | tr '\n' ',')
if echo "$SUB_ROLES" | grep -Eq 'Owner|User Access Administrator'; then ok "can assign roles at subscription scope (roles: $SUB_ROLES)"
else echo "  WARN  no Owner/User Access Administrator on the subscription (roles: ${SUB_ROLES:-none}); role assignments in step 5 will fail unless you hold those roles on the target resource groups." >&2; fi
if echo "$SUB_ROLES" | grep -Eq 'Owner|Contributor'; then ok "can create resource groups"; else echo "  FAIL  need Contributor or Owner on the subscription to create resource groups" >&2; PRE_FAIL=1; fi
[ "${PRE_FAIL:-0}" = 0 ] || { echo "preflight failed; nothing changed" >&2; exit 1; }
$APPLY || say "Dry run (add --apply to execute). Commands that would run:"

# ---- 1. app registration + service principal ----
say "1. App registration $APP_NAME"
APP_ID=$(az ad app list --display-name "$APP_NAME" --query "[0].appId" -o tsv)
if [ -n "$APP_ID" ]; then ok "exists: appId $APP_ID"; else todo "create app registration"; run az ad app create --display-name "$APP_NAME" --sign-in-audience AzureADMyOrg --query appId -o tsv; $APPLY && APP_ID=$(az ad app list --display-name "$APP_NAME" --query "[0].appId" -o tsv); fi
if [ -n "${APP_ID:-}" ]; then
  APP_OBJ=$(az ad app show --id "$APP_ID" --query id -o tsv)
  SP_ID=$(az ad sp list --filter "appId eq '$APP_ID'" --query "[0].id" -o tsv)
  if [ -n "$SP_ID" ]; then ok "service principal exists: $SP_ID"; else todo "create service principal"; run az ad sp create --id "$APP_ID"; $APPLY && SP_ID=$(az ad sp list --filter "appId eq '$APP_ID'" --query "[0].id" -o tsv); fi
fi

# ---- 2. federated credentials ----
say "2. Federated credentials (issuer $ISSUER, audience $AUDIENCE)"
<%#eq options.runner "github-actions"%>fed() { # name subject
  local name="$1" subject="$2"
  if [ -n "${APP_OBJ:-}" ] && az ad app federated-credential list --id "$APP_OBJ" --query "[?subject=='$subject'] | length(@)" -o tsv 2>/dev/null | grep -q '^[1-9]'; then ok "$name: $subject"; return; fi
  todo "add $name: $subject"
  run az ad app federated-credential create --id "${APP_OBJ:-<app-object-id>}" --parameters "{\"name\":\"$name\",\"issuer\":\"$ISSUER\",\"subject\":\"$subject\",\"audiences\":[\"$AUDIENCE\"]}"
}
fed "github-${GH_BRANCH//\//-}" "repo:${GH_OWNER}/${GH_REPO}:ref:refs/heads/${GH_BRANCH}"
fed "github-env-${GH_ENV}"      "repo:${GH_OWNER}/${GH_REPO}:environment:${GH_ENV}"
<%/eq%>
# ---- 3. terraform state storage (Entra-only auth) ----
say "3. Terraform state: $STATE_RG / $STATE_SA / $STATE_CONTAINER"
az group show -n "$STATE_RG" >/dev/null 2>&1 && ok "resource group $STATE_RG" || { todo "create resource group $STATE_RG"; run az group create -n "$STATE_RG" -l "$LOCATION" -o none; }
if az storage account show -n "$STATE_SA" -g "$STATE_RG" >/dev/null 2>&1; then ok "storage account $STATE_SA"
else todo "create storage account $STATE_SA (shared key disabled)"; run az storage account create -n "$STATE_SA" -g "$STATE_RG" -l "$LOCATION" --sku Standard_LRS --kind StorageV2 --min-tls-version TLS1_2 --allow-blob-public-access false --allow-shared-key-access false -o none; fi
SA_SCOPE="/subscriptions/$SUB_ID/resourceGroups/$STATE_RG/providers/Microsoft.Storage/storageAccounts/$STATE_SA"
CONTAINER_SCOPE="$SA_SCOPE/blobServices/default/containers/$STATE_CONTAINER"

# ---- 4. environment resource group ----
say "4. Resource group $RG"
az group show -n "$RG" >/dev/null 2>&1 && ok "resource group $RG" || { todo "create resource group $RG"; run az group create -n "$RG" -l "$LOCATION" -o none; }
RG_SCOPE="/subscriptions/$SUB_ID/resourceGroups/$RG"

# ---- 5. role assignments ----
say "5. Role assignments (least privilege)"
assign() { # principal-object-id principal-type role scope label
  local pid="$1" ptype="$2" role="$3" scope="$4" label="$5"
  if [ -n "$pid" ] && [ "$(az role assignment list --assignee "$pid" --scope "$scope" --query "[?roleDefinitionName=='$role'] | length(@)" -o tsv 2>/dev/null)" != "0" ] && [ -n "$(az role assignment list --assignee "$pid" --scope "$scope" --query "[?roleDefinitionName=='$role'] | length(@)" -o tsv 2>/dev/null)" ]; then ok "$label: $role"; return; fi
  todo "$label: $role on ${scope#/subscriptions/$SUB_ID/}"
  run az role assignment create --assignee-object-id "${pid:-<sp-object-id>}" --assignee-principal-type "$ptype" --role "$role" --scope "$scope" -o none
}
# the human: create the state container, apply infra/foundation (creates role assignments), set Key Vault values
assign "$ME_ID" User "Storage Blob Data Contributor" "$SA_SCOPE" "you"
assign "$ME_ID" User "User Access Administrator"     "$RG_SCOPE" "you"
# the CI/CD principal
assign "${SP_ID:-}" ServicePrincipal "Contributor"                   "$RG_SCOPE"        "sp"
assign "${SP_ID:-}" ServicePrincipal "Storage Blob Data Contributor" "$CONTAINER_SCOPE" "sp"
# state container needs the data-plane role above; create it last
if $APPLY; then
  if az storage container show -n "$STATE_CONTAINER" --account-name "$STATE_SA" --auth-mode login >/dev/null 2>&1; then ok "container $STATE_CONTAINER"
  else todo "create container $STATE_CONTAINER (RBAC propagation can take ~1 min; retrying)"; for i in 1 2 3 4 5 6; do az storage container create -n "$STATE_CONTAINER" --account-name "$STATE_SA" --auth-mode login -o none 2>/dev/null && break || sleep 10; done; az storage container show -n "$STATE_CONTAINER" --account-name "$STATE_SA" --auth-mode login >/dev/null; fi
else todo "create container $STATE_CONTAINER"; run az storage container create -n "$STATE_CONTAINER" --account-name "$STATE_SA" --auth-mode login -o none; fi

# ---- 6. outputs ----
say "6. Values for GitHub (identifiers, not secrets; stored as secrets so they stay out of public logs)"
printf '  AZURE_CLIENT_ID=%s\n  AZURE_TENANT_ID=%s\n  AZURE_SUBSCRIPTION_ID=%s\n' "${APP_ID:-<after --apply>}" "$TENANT_ID" "$SUB_ID"
<%#eq options.runner "github-actions"%>if $SET_SECRETS && $APPLY; then
  command -v gh >/dev/null || { echo "gh not installed; set the secrets manually" >&2; exit 1; }
  printf '%s' "$APP_ID"    | gh secret set AZURE_CLIENT_ID       -R "$GH_OWNER/$GH_REPO"
  printf '%s' "$TENANT_ID" | gh secret set AZURE_TENANT_ID       -R "$GH_OWNER/$GH_REPO"
  printf '%s' "$SUB_ID"    | gh secret set AZURE_SUBSCRIPTION_ID -R "$GH_OWNER/$GH_REPO"
  ok "GitHub secrets set on $GH_OWNER/$GH_REPO"
else
  printf '  Then:  printf %%s "$AZURE_CLIENT_ID" | gh secret set AZURE_CLIENT_ID -R %s/%s   (same for TENANT and SUBSCRIPTION), or re-run with --apply --set-github-secrets\n' "$GH_OWNER" "$GH_REPO"
fi
printf '  Still manual: gh secret set DOCKERHUB_TOKEN -R %s/%s ; gh variable set DOCKERHUB_USERNAME -R %s/%s --body <user> ; environment "%s" with a required reviewer.\n' "$GH_OWNER" "$GH_REPO" "$GH_OWNER" "$GH_REPO" "$GH_ENV"
<%/eq%>say "Done$($APPLY || echo ' (dry run)'). Next: /adlc:plan dev --layer foundation"
