# Generated by adlc (runner=github-actions, versioning=<% options.versioning %>). Regenerate with the scaffold; do not hand-edit.
# CI: build, test, compute the version, build images with the version stamped in, push immutable tags on <% github.default_branch %>,
# publish a release manifest. CD is a separate workflow (cd.yml) triggered with an explicit tag.
name: ci

on:
  pull_request:
    branches: [<% github.default_branch %>]
  push:
    branches: [<% github.default_branch %>]
  workflow_dispatch:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: write   # <% options.versioning %> creates the release tag on <% github.default_branch %>
  id-token: write   # OIDC token for azure/login (no stored cloud credentials)
  pull-requests: read

env:
  REGISTRY: <% derived.registry_host %>
  IS_RELEASE: ${{ github.event_name != 'pull_request' && github.ref == 'refs/heads/<% github.default_branch %>' }}

jobs:
  version:
    name: version
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.v.outputs.version }}
      commit: ${{ steps.v.outputs.commit }}
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0   # full history: the version depends on it
<%#eq options.versioning "nbgv"%>      - uses: actions/setup-dotnet@v6
        with:
          dotnet-version: 8.0.x
      - name: Compute version with Nerdbank.GitVersioning
        id: nbgv
        uses: dotnet/nbgv@v0.5.2
      - id: v
        run: |
          echo "version=${{ steps.nbgv.outputs.SemVer2 }}" >> "$GITHUB_OUTPUT"
          echo "commit=${{ steps.nbgv.outputs.GitCommitIdShort }}" >> "$GITHUB_OUTPUT"
          echo "public_release=${{ steps.nbgv.outputs.PublicRelease }}" >> "$GITHUB_OUTPUT"
          echo "### Version ${{ steps.nbgv.outputs.SemVer2 }} (public release: ${{ steps.nbgv.outputs.PublicRelease }})" >> "$GITHUB_STEP_SUMMARY"
<%/eq%><%#eq options.versioning "semantic-release"%>      - uses: actions/setup-node@v7
        with:
          node-version: 22
      - name: Compute next version with semantic-release (dry run)
        id: sr
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          npm ci --no-audit --no-fund
          # semantic-release prints "The next release version is X.Y.Z" in dry-run mode; on non-release branches or with no
          # releasable commits there is no version and the images are tagged with the commit only.
          NEXT=$(npx semantic-release --dry-run --no-ci 2>&1 | sed -nE 's/.*The next release version is ([0-9]+\.[0-9]+\.[0-9]+[^ ]*).*/\1/p' | tail -1)
          echo "next=${NEXT}" >> "$GITHUB_OUTPUT"
      - id: v
        run: |
          SHORT=$(git rev-parse --short HEAD)
          echo "version=${{ steps.sr.outputs.next || format('0.0.0-sha.{0}', github.sha) }}" >> "$GITHUB_OUTPUT"
          echo "commit=$SHORT" >> "$GITHUB_OUTPUT"
<%/eq%>
  test:
    name: test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
<%#if derived.has_dotnet%>      - uses: actions/setup-dotnet@v6
        with:
          dotnet-version: 8.0.x
<%/if%><%#if derived.has_node%>      - uses: actions/setup-node@v7
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: |
<%#each derived.apps%><%#if is_node%>            <% path %>/package-lock.json
<%/if%><%/each%><%/if%><%#each derived.apps%><%#if is_node%>      - name: install <% name %> dependencies
        run: npm ci --prefix <% path %> --no-audit --no-fund
<%/if%><%/each%><%#each derived.apps%><%#if test_command%>      - name: test <% name %>
        run: <% test_command %>
<%/if%><%/each%>
  images:
    name: image ${{ matrix.app }}
    needs: [version, test]
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
<%#each derived.apps%>          - app: <% name %>
            path: <% path %>
            repository: <% image_repository %>
<%/each%>    outputs:
<%#each derived.apps%>      digest_<% name %>: ${{ steps.build.outputs.digest }}
<%/each%>    steps:
      - uses: actions/checkout@v7
      - uses: docker/setup-buildx-action@v4
<%#eq options.base_image "dhi"%>      - name: Log in to Docker Hardened Images
        uses: docker/login-action@v4
        with:
          registry: dhi.io
          username: ${{ vars.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}
<%/eq%><%#eq options.cloud "azure"%>      - name: Azure login (OIDC)
        if: env.IS_RELEASE == 'true'
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
<%/eq%><%#eq options.registry "acr"%>      - name: Log in to the container registry
        if: env.IS_RELEASE == 'true'
        run: az acr login --name <% azure.acr_name %>
      - name: Refuse to overwrite an existing tag (tags are immutable)
        if: env.IS_RELEASE == 'true'
        run: |
          if az acr manifest show -r <% azure.acr_name %> -n "${{ matrix.repository }}:${{ needs.version.outputs.version }}" >/dev/null 2>&1; then
            echo "::error::${{ matrix.repository }}:${{ needs.version.outputs.version }} already exists in <% azure.acr_name %>. Tags are immutable: bump the version (new commit) instead of re-running a release build."
            exit 1
          fi
<%/eq%>      - name: Build${{ env.IS_RELEASE == 'true' && ' and push' || '' }} ${{ matrix.app }}
        id: build
        uses: docker/build-push-action@v7
        with:
          context: ${{ matrix.path }}
          push: ${{ env.IS_RELEASE == 'true' }}
          load: ${{ env.IS_RELEASE != 'true' }}
          provenance: false   # single image manifest, so the registry digest equals the running image digest
          sbom: false
          build-args: |
            VERSION=${{ needs.version.outputs.version }}
            COMMIT=${{ needs.version.outputs.commit }}
          tags: |
            ${{ env.REGISTRY }}/${{ matrix.repository }}:${{ needs.version.outputs.version }}
            ${{ env.REGISTRY }}/${{ matrix.repository }}:sha-${{ needs.version.outputs.commit }}
          cache-from: type=gha,scope=${{ matrix.app }}
          cache-to: type=gha,scope=${{ matrix.app }},mode=max
      - name: Record image
        run: |
          mkdir -p manifest
          printf '{"app":"%s","image":"%s","tag":"%s","digest":"%s"}\n' "${{ matrix.app }}" "${{ env.REGISTRY }}/${{ matrix.repository }}" "${{ needs.version.outputs.version }}" "${{ steps.build.outputs.digest }}" > "manifest/${{ matrix.app }}.json"
          echo "- \`${{ env.REGISTRY }}/${{ matrix.repository }}:${{ needs.version.outputs.version }}\` ${{ steps.build.outputs.digest }}" >> "$GITHUB_STEP_SUMMARY"
      - uses: actions/upload-artifact@v7
        with:
          name: image-${{ matrix.app }}
          path: manifest/
          retention-days: 30

  release:
    name: release ${{ needs.version.outputs.version }}
    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/<% github.default_branch %>'
    needs: [version, images]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: actions/download-artifact@v7
        with:
          pattern: image-*
          merge-multiple: true
          path: manifest
      - name: Assemble release manifest
        run: |
          python3 - <<'PY'
          import json,glob,os
          images=[json.load(open(f)) for f in sorted(glob.glob("manifest/*.json"))]
          m={"project":"<% project.name %>","version":"${{ needs.version.outputs.version }}","commit":"${{ github.sha }}","run_id":"${{ github.run_id }}","images":images}
          json.dump(m,open("release-manifest.json","w"),indent=2); print(json.dumps(m,indent=2))
          PY
      - uses: actions/upload-artifact@v7
        with:
          name: release-manifest-${{ needs.version.outputs.version }}
          path: release-manifest.json
          retention-days: 90
<%#eq options.versioning "nbgv"%>      - uses: actions/setup-dotnet@v6
        with:
          dotnet-version: 8.0.x
      - name: Tag the release commit
        run: |
          dotnet tool install -g nbgv >/dev/null
          git config user.name "github-actions[bot]"; git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          if git ls-remote --exit-code --tags origin "v${{ needs.version.outputs.version }}" >/dev/null 2>&1; then
            echo "tag v${{ needs.version.outputs.version }} already exists; nothing to do"
          else
            nbgv tag
            git push origin "v${{ needs.version.outputs.version }}"
          fi
<%/eq%><%#eq options.versioning "semantic-release"%>      - uses: actions/setup-node@v7
        with:
          node-version: 22
      - name: Publish the release (tag, notes, changelog)
        if: needs.version.outputs.version != '' && !startsWith(needs.version.outputs.version, '0.0.0-sha.')
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: npm ci --no-audit --no-fund && npx semantic-release
<%/eq%>      - name: Summary
        run: |
          echo "## Release <% project.name %> ${{ needs.version.outputs.version }}" >> "$GITHUB_STEP_SUMMARY"
          echo "Deploy with: \`/adlc:deploy ${{ needs.version.outputs.version }} <% github.cd_environment %>\`" >> "$GITHUB_STEP_SUMMARY"
