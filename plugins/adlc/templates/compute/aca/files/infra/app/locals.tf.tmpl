# Values rendered from .adlc/config.yaml. Change them with /adlc:bootstrap, then re-scaffold.
locals {
  project     = "<% project.name %>"
  environment = "<% derived.env %>"

  resource_group_name = "<% azure.resource_group %>"
  acr_name            = "<% azure.acr_name %>"
  key_vault_name      = "<% azure.key_vault_name %>"
  identity_name       = "<% azure.identity_name %>"
  log_analytics_name  = "log-<% project.name %>-<% derived.env %>"
  cae_name            = "cae-<% project.name %>-<% derived.env %>"

  tags = {
    project     = local.project
    environment = local.environment
    managed_by  = "terraform"
    layer       = "app"
    generator   = "adlc"
  }
}
