# Generated by adlc (cloud=azure, compute=aca, layer=app). Applied only by the CD workflow behind the environment approval.
terraform {
  required_version = ">= 1.9"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 5.0"
    }
  }

  backend "azurerm" {
    resource_group_name  = "<% azure.state.resource_group %>"
    storage_account_name = "<% azure.state.storage_account %>"
    container_name       = "<% azure.state.container %>"
    key                  = "<% project.name %>/app/<% derived.env %>.tfstate"
    use_azuread_auth     = true
  }
}
